# Python runtime.
src/wg_version.py usr/lib/wg-manager/src/
src/wg_manager/*.py usr/lib/wg-manager/src/wg_manager/

# Production systemd units.
systemd/production/wg-manager.socket usr/lib/systemd/system/
systemd/production/wg-manager@.service usr/lib/systemd/system/

# Production configuration.
config/production/wg-manager.conf etc/wg-manager/
debian/certificates.README usr/share/doc/wg-manager-controller/
debian/sysusers/wg-manager-controller.conf usr/lib/sysusers.d/
tools/package/wg-manager-check-controller usr/sbin/
docs/deployment.md usr/share/doc/wg-manager-controller/
docs/configuration.md usr/share/doc/wg-manager-controller/
