# Python runtime package root.
src/wg_version.py usr/lib/wg-manager/src/
src/wg_auth/*.py usr/lib/wg-manager/src/wg_auth/
src/wg_client/*.py usr/lib/wg-manager/src/wg_client/

# Browser frontend.
src/wg_frontend/www/vpn/* usr/share/wg-manager/frontend/
src/wg_frontend/wg_auth_session.js usr/share/wg-manager/js/
src/wg_frontend/wg_opaque_client.js usr/share/wg-manager/js/
src/wg_frontend/wg_client_api.js usr/share/wg-manager/js/
src/wg_frontend/wg_secure_session.js usr/share/wg-manager/js/
src/wg_frontend/wg_client_errors.js usr/share/wg-manager/js/
vendor/libopaque.js usr/share/wg-manager/js/vendor/
src/wg_frontend/vendor/LICENSE.libopaque usr/share/doc/wg-manager-auth-client/

# Production systemd units.
systemd/production/wg-auth.service usr/lib/systemd/system/
systemd/production/wg-client.socket usr/lib/systemd/system/
systemd/production/wg-client@.service usr/lib/systemd/system/

# Production configuration and Apache integration.
config/production/wg-auth.conf etc/wg-manager/
config/production/wg-client.conf etc/wg-manager/
apache/production/wg-manager.conf etc/apache2/conf-available/
tools/manage_users.py usr/lib/wg-manager/tools/
debian/wg-manager-users usr/sbin/
debian/certificates.README usr/share/doc/wg-manager-auth-client/
debian/sysusers/wg-manager-auth-client.conf usr/lib/sysusers.d/
tools/package/wg-manager-check-auth-client usr/sbin/
docs/deployment.md usr/share/doc/wg-manager-auth-client/
docs/configuration.md usr/share/doc/wg-manager-auth-client/
