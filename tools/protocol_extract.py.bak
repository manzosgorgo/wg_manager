#!/usr/bin/env python3

from __future__ import annotations

import argparse
import ast
import re
from dataclasses import dataclass, field
from pathlib import Path


EXCLUDED_DIRS = {
    ".git",
    ".idea",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    "node_modules",
    "dist",
    "build",
    "coverage",
    "login",
}

PYTHON_SUFFIXES = {".py"}
JS_SUFFIXES = {".js", ".mjs", ".cjs"}

PROTOCOL_CALLS = {
    "json.dumps",
    "json.loads",
    "JSON.stringify",
    "JSON.parse",
}

TRANSPORT_CALLS = {
    "send",
    "sendall",
    "recv",
    "recv_into",
    "sendto",
    "send_message",
    "write",
    "read",
}

OPAQUE_PREFIXES = (
    "opaque.",
    "Opaque.",
    "libopaque.",
)

STATE_RE = re.compile(r"\b[A-Z][A-Z0-9_]*STATE[A-Z0-9_]*\b")
STATE_NAME_RE = re.compile(r"\bSTATE_[A-Z0-9_]+\b")


@dataclass
class Finding:
    kind: str
    line: int
    detail: str


@dataclass
class FunctionInfo:
    name: str
    line: int
    end_line: int
    class_name: str | None = None
    findings: list[Finding] = field(default_factory=list)

    @property
    def qualified_name(self) -> str:
        if self.class_name:
            return f"{self.class_name}.{self.name}"
        return self.name

    @property
    def interesting(self) -> bool:
        return bool(self.findings)


def expr_text(node: ast.AST) -> str:
    try:
        return ast.unparse(node)
    except (AttributeError, ValueError):
        return "..."


def call_name(node: ast.Call) -> str | None:
    func = node.func

    if isinstance(func, ast.Name):
        return func.id

    if isinstance(func, ast.Attribute):
        parts = []

        current = func

        while isinstance(current, ast.Attribute):
            parts.append(current.attr)
            current = current.value

        if isinstance(current, ast.Name):
            parts.append(current.id)
            return ".".join(reversed(parts))

    return None


def is_name(node: ast.AST, name: str) -> bool:
    return isinstance(node, ast.Name) and node.id == name


def is_dict_protocol_candidate(node: ast.Dict) -> bool:
    """
    A dict is interesting if it contains obvious protocol-looking fields.

    We intentionally do NOT classify every dict as a protocol message.
    """

    protocol_keys = {
        "type",
        "status",
        "protocol_version",
        "session_id",
        "client_id",
        "username",
        "password",
        "credential",
        "credentials",
        "auth",
        "authU",
        "pubU",
        "response",
        "request",
        "peer",
        "peers",
        "error",
        "code",
        "message",
        "listen_path",
        "timeout",
        "created_at",
        "k_session",
    }

    for key in node.keys:
        if isinstance(key, ast.Constant) and isinstance(key.value, str):
            if key.value in protocol_keys:
                return True

    return False


def extract_dict_fields(node: ast.Dict) -> list[str]:
    fields = []

    for key in node.keys:
        if isinstance(key, ast.Constant) and isinstance(key.value, str):
            fields.append(key.value)

        elif key is None:
            fields.append("**" + expr_text(node) + "**")

    return fields


def add_finding(
    info: FunctionInfo,
    kind: str,
    node: ast.AST,
    detail: str,
):
    info.findings.append(
        Finding(
            kind=kind,
            line=getattr(node, "lineno", info.line),
            detail=detail,
        )
    )


class PythonProtocolVisitor(ast.NodeVisitor):
    def __init__(self, info: FunctionInfo):
        self.info = info

    def visit_Dict(self, node: ast.Dict):
        if is_dict_protocol_candidate(node):
            fields = extract_dict_fields(node)

            add_finding(
                self.info,
                "message construction",
                node,
                f"dict with fields: {', '.join(fields)}",
            )

        self.generic_visit(node)

    def visit_Call(self, node: ast.Call):
        name = call_name(node)

        if name in PROTOCOL_CALLS:
            if name == "json.dumps":
                if node.args:
                    add_finding(
                        self.info,
                        "JSON serialization",
                        node,
                        f"json.dumps({expr_text(node.args[0])})",
                    )
                else:
                    add_finding(
                        self.info,
                        "JSON serialization",
                        node,
                        "json.dumps(...)",
                    )

            elif name == "json.loads":
                if node.args:
                    add_finding(
                        self.info,
                        "JSON parsing",
                        node,
                        f"json.loads({expr_text(node.args[0])})",
                    )
                else:
                    add_finding(
                        self.info,
                        "JSON parsing",
                        node,
                        "json.loads(...)",
                    )

        if name:
            short_name = name.split(".")[-1]

            if short_name in TRANSPORT_CALLS:
                add_finding(
                    self.info,
                    "transport",
                    node,
                    name,
                )

            if any(
                name.startswith(prefix)
                for prefix in OPAQUE_PREFIXES
            ):
                add_finding(
                    self.info,
                    "OPAQUE",
                    node,
                    name,
                )

        self.generic_visit(node)

    def visit_Subscript(self, node: ast.Subscript):
        """
        Detect:

            data["type"]
            data["session_id"]
            response["status"]
        """

        slice_node = node.slice

        if isinstance(slice_node, ast.Constant):
            if isinstance(slice_node.value, str):
                field = slice_node.value

                add_finding(
                    self.info,
                    "field access",
                    node,
                    f"{expr_text(node.value)}[{field!r}]",
                )

        self.generic_visit(node)

    def visit_Attribute(self, node: ast.Attribute):
        """
        Detect state-like attributes such as:

            self.STATE_AUTHENTICATED
            self._state
            session.state
        """

        name = node.attr

        if STATE_NAME_RE.fullmatch(name):
            add_finding(
                self.info,
                "state",
                node,
                name,
            )

        if name in {
            "_state",
            "state",
            "_session_id",
            "session_id",
            "_k_session",
            "k_session",
            "_authU0",
        }:
            add_finding(
                self.info,
                "protocol state/material",
                node,
                expr_text(node),
            )

        self.generic_visit(node)

    def visit_Assign(self, node: ast.Assign):
        """
        Detect assignments such as:

            self._state = self.STATE_AUTHENTICATING
            response = {...}
            self._session_id = ...
        """

        target_texts = [
            expr_text(target)
            for target in node.targets
        ]

        value_text = expr_text(node.value)

        if any(
            target.endswith("_state")
            or target.endswith(".state")
            or target.endswith("_session_id")
            or target.endswith(".session_id")
            or target.endswith("_k_session")
            or target.endswith(".k_session")
            for target in target_texts
        ):
            add_finding(
                self.info,
                "state/material assignment",
                node,
                f"{', '.join(target_texts)} = {value_text}",
            )

        if isinstance(node.value, ast.Dict):
            if is_dict_protocol_candidate(node.value):
                fields = extract_dict_fields(node.value)

                add_finding(
                    self.info,
                    "message assignment",
                    node,
                    f"{', '.join(target_texts)} = dict({', '.join(fields)})",
                )

        self.generic_visit(node)

    def visit_Return(self, node: ast.Return):
        if node.value is not None:
            if isinstance(node.value, ast.Name):
                name = node.value.id

                if name in {
                    "response",
                    "request",
                    "result",
                    "data",
                    "message",
                }:
                    add_finding(
                        self.info,
                        "message return",
                        node,
                        f"return {name}",
                    )

            elif isinstance(node.value, ast.Dict):
                if is_dict_protocol_candidate(node.value):
                    fields = extract_dict_fields(node.value)

                    add_finding(
                        self.info,
                        "message return",
                        node,
                        f"return dict({', '.join(fields)})",
                    )

        self.generic_visit(node)


def extract_python_functions(
    path: Path,
) -> list[FunctionInfo]:

    try:
        source = path.read_text(encoding="utf-8")
        tree = ast.parse(source, filename=str(path))
    except (OSError, UnicodeDecodeError, SyntaxError):
        return []

    results = []

    for node in ast.walk(tree):
        if not isinstance(
            node,
            (ast.FunctionDef, ast.AsyncFunctionDef),
        ):
            continue

        class_name = None

        # Find the containing class.
        for parent in ast.walk(tree):
            if not isinstance(parent, ast.ClassDef):
                continue

            if node in parent.body:
                class_name = parent.name
                break

        info = FunctionInfo(
            name=node.name,
            line=node.lineno,
            end_line=getattr(node, "end_lineno", node.lineno),
            class_name=class_name,
        )

        visitor = PythonProtocolVisitor(info)
        visitor.visit(node)

        if info.interesting:
            results.append(info)

    results.sort(key=lambda item: item.line)

    return results


# ---------------------------------------------------------------------------
# JavaScript
# ---------------------------------------------------------------------------

JS_FUNCTION_RE = re.compile(
    r"""
    (?:
        function\s+(?P<function>[A-Za-z_$][\w$]*)
        |
        (?P<arrow>[A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>
    )
    """,
    re.VERBOSE,
)

JS_CALL_RE = re.compile(
    r"""
    \b(
        JSON\.stringify
        |
        JSON\.parse
        |
        fetch
        |
        XMLHttpRequest
    )\s*\(
    """,
    re.VERBOSE,
)

JS_STATE_RE = re.compile(
    r"\bSTATE_[A-Z0-9_]+\b"
)

JS_FIELD_ACCESS_RE = re.compile(
    r"""
    (?:
        \.([A-Za-z_$][\w$]*)
        |
        \[['"]([^'"]+)['"]\]
    )
    """,
    re.VERBOSE,
)

JS_PROTOCOL_FIELD_RE = re.compile(
    r"""
    \b(
        protocol_version
        |
        type
        |
        status
        |
        session_id
        |
        client_id
        |
        username
        |
        credential
        |
        authU
        |
        pubU
        |
        k_session
        |
        listen_path
        |
        timeout
        |
        created_at
        |
        peer
        |
        peers
        |
        error
        |
        code
        |
        message
    )\b
    """,
    re.VERBOSE,
)


def extract_javascript(path: Path) -> list[FunctionInfo]:

    try:
        source = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return []

    lines = source.splitlines()

    results = []

    for match in JS_FUNCTION_RE.finditer(source):
        name = match.group("function") or match.group("arrow")

        if not name:
            continue

        line = source.count("\n", 0, match.start()) + 1

        # We don't have a real JS parser here, so use a bounded window.
        start = match.start()
        end = source.find("\n}", start)

        if end == -1:
            end = min(len(source), start + 5000)

        chunk = source[start:end + 2]

        findings = []

        for call in JS_CALL_RE.finditer(chunk):
            findings.append(
                Finding(
                    kind="JSON/HTTP",
                    line=line + chunk.count("\n", 0, call.start()),
                    detail=call.group(1),
                )
            )

        for state in JS_STATE_RE.finditer(chunk):
            findings.append(
                Finding(
                    kind="state",
                    line=line + chunk.count("\n", 0, state.start()),
                    detail=state.group(0),
                )
            )

        for field in JS_PROTOCOL_FIELD_RE.finditer(chunk):
            findings.append(
                Finding(
                    kind="protocol field",
                    line=line + chunk.count("\n", 0, field.start()),
                    detail=field.group(1),
                )
            )

        if "JSON.stringify" in chunk:
            findings.append(
                Finding(
                    kind="message production",
                    line=line,
                    detail="JSON.stringify(...)",
                )
            )

        if "JSON.parse" in chunk:
            findings.append(
                Finding(
                    kind="message consumption",
                    line=line,
                    detail="JSON.parse(...)",
                )
            )

        if not findings:
            continue

        results.append(
            FunctionInfo(
                name=name,
                line=line,
                end_line=line + chunk.count("\n"),
                findings=findings,
            )
        )

    return results


def extract_file(path: Path) -> list[FunctionInfo]:
    if path.suffix in PYTHON_SUFFIXES:
        return extract_python_functions(path)

    if path.suffix in JS_SUFFIXES:
        return extract_javascript(path)

    return []


def iter_source_files(repo: Path):
    for path in sorted(repo.rglob("*")):
        if not path.is_file():
            continue

        if path.suffix not in PYTHON_SUFFIXES | JS_SUFFIXES:
            continue

        rel = path.relative_to(repo)

        if any(part in EXCLUDED_DIRS for part in rel.parts):
            continue

        yield path


def build_report(repo: Path) -> str:

    lines = [
        "# Extracted Protocol Candidates",
        "",
        "Mechanically extracted protocol-related code paths.",
        "",
        "> This document is generated from source code.",
        "> It is not a protocol specification.",
        "> Findings are observations and require human verification.",
        "",
    ]

    total_files = 0
    total_functions = 0
    total_findings = 0

    for path in iter_source_files(repo):
        functions = extract_file(path)

        if not functions:
            continue

        total_files += 1

        rel = path.relative_to(repo)

        lines.append(f"## `{rel}`")
        lines.append("")

        for function in functions:
            total_functions += 1
            total_findings += len(function.findings)

            lines.append(
                f"### `{function.qualified_name}()` "
                f"— line {function.line}"
            )
            lines.append("")

            for finding in sorted(
                function.findings,
                key=lambda item: item.line,
            ):
                lines.append(
                    f"- **{finding.kind}** — "
                    f"line {finding.line}: `{finding.detail}`"
                )

            lines.append("")

    summary = [
        "## Extraction summary",
        "",
        f"- Files: **{total_files}**",
        f"- Functions: **{total_functions}**",
        f"- Findings: **{total_findings}**",
        "",
    ]

    lines[5:5] = summary

    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Extract protocol-related message flows, JSON operations, "
            "state transitions and authentication calls."
        )
    )

    parser.add_argument(
        "repo",
        nargs="?",
        type=Path,
        default=Path.cwd(),
    )

    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        default=None,
    )

    args = parser.parse_args()

    repo = args.repo.resolve()

    if not repo.is_dir():
        raise SystemExit(f"Not a directory: {repo}")

    output = args.output

    if output is None:
        output = (
            repo
            / "docs"
            / "ai"
            / "protocol-extracted.md"
        )
    else:
        output = output.resolve()

    output.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    report = build_report(repo)

    output.write_text(
        report,
        encoding="utf-8",
    )

    print(
        f"Protocol extraction written to: {output}"
    )


if __name__ == "__main__":
    main()